{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // Lets the admin panel import vault-react/src/HangingGarment.jsx (+
    // Hanger.jsx) directly as source, so its hanger preview is the exact
    // same component the live site renders — no separate implementation
    // to keep in sync. checkJs is intentionally left off: these files
    // stay untyped JS, they just need to be resolvable by tsc.
    "allowJs": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
