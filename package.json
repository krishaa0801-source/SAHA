{
  "name": "saha-project",
  "version": "1.0.0",
  "private": true,
  "description": "SAHA - saree/outfit rental site",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prestart": "npm run build:auth && npm run build:vault",
    "build": "npm run build:auth && npm run build:vault",
    "build:auth": "cd client && npm install && npm run build",
    "build:vault": "node vault-react/build.mjs",
    "make:admin": "node scripts/makeAdmin.js",
    "seed:categories": "node scripts/seedCategories.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.3",
    "multer": "^2.2.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
