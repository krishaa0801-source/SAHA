PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saha?retryWrites=true&w=majority

# Long random string used to sign session cookies — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Razorpay Standard Checkout keys (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-your-key-secret

# Cloudinary (server/services/imageProcessor.js) — required. Product and
# review images are uploaded here instead of local disk, since this app's
# Node.js hosting rebuilds the app directory from scratch on every
# deploy, which used to wipe anything written to disk at runtime. Get
# this from Cloudinary Dashboard > Settings > API Keys — it shows the
# exact cloudinary://<api_key>:<api_secret>@<cloud_name> string to copy.
CLOUDINARY_URL=cloudinary://replace-with-your-api-key:replace-with-your-api-secret@replace-with-your-cloud-name

# Optional but recommended: secret for the POST /api/payments/webhook
# fallback (server/routes/payments.js), which confirms orders even if the
# browser tab closes right after Razorpay charges the card. Create a
# webhook in Razorpay Dashboard > Settings > Webhooks pointing at
# https://<your-domain>/api/payments/webhook, subscribed to the
# "payment.captured" event, and paste the secret it gives you here. Not
# validated at startup — the app runs fine without it, but that fallback
# stays inactive (and logs an error on every call) until it's set.
# RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Comma-separated list of extra origins allowed to make cross-origin
# credentialed requests (e.g. a separate frontend domain). Leave unset for
# this app's normal same-origin deployment — CORS is disabled by default,
# which is the correct/secure setting when the frontend and API share one
# origin. Only set this if a separate frontend origin is ever added, and if
# you do, re-check server/middleware/csrf.js's same-origin assumption.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
